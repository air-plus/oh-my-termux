[include]
	path = ~/.config/delta/config.gitconfig
{{- if and (hasKey . "name") (hasKey . "email") (hasKey . "signingkey") }}
[user]
	name = {{ .name }}
	email = {{ .email }}
	signingkey = {{ .signingkey }}
{{- end }}
{{- if hasKey . "gpgsign" }}
[commit]
	gpgsign = {{ .gpgsign }}
{{- end }}
[merge]
	conflictStyle = zdiff3
[init]
	defaultBranch = main
